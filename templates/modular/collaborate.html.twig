{% set contact_email = page.header.email ?: theme_config.contact_email %}
<section class="jn-section" id="collaborate">
    <div class="jn-container">
        <div class="jn-card jn-collab-banner">
            <div class="jn-collab-grid">
                <div class="jn-collab-left">
                    <div class="jn-section-title-group">
                        <span class="jn-index-pill">03</span>
                        <span class="jn-mono jn-xs jn-cyan-text">COLLABORATE OR MORE // CONTACT ME</span>
                    </div>

                    <h2 class="jn-collab-heading">
                        {{ page.header.heading_bold|default("Let's craft visual systems &") }}
                        <span class="jn-serif-italic">{{ page.header.heading_italic|default('ship bold products.') }}</span>
                    </h2>

                    <p class="jn-muted jn-collab-copy">
                        {{ page.header.description }}
                    </p>

                    <div class="jn-collab-pillars">
                        {% for item in page.header.services %}
                        <div class="jn-pillar-item">
                            <span class="jn-mono jn-xs jn-crimson-text">{{ "%02d"|format(loop.index) }}</span>
                            <div>
                                <strong>{{ item.title }}</strong>
                                <p class="jn-muted">{{ item.desc }}</p>
                            </div>
                        </div>
                        {% endfor %}
                    </div>

                    {% if contact_email or page.header.socials %}
                    <div class="jn-direct-contact-bar">
                        {% if contact_email %}
                        <button type="button" class="jn-btn jn-btn-outline" id="jnCopyEmailBtn"
                                data-email="{{ contact_email|e('html_attr') }}">
                            Copy Email: {{ contact_email }}
                        </button>
                        {% endif %}
                        {% if page.header.socials %}
                        <div class="jn-social-pills">
                            {% for soc in page.header.socials %}
                                <a href="{{ soc.url|e('html_attr') }}" target="_blank" rel="noopener" class="jn-social-pill">{{ soc.label }}</a>
                            {% endfor %}
                        </div>
                        {% endif %}
                    </div>
                    {% endif %}
                </div>

                <div class="jn-collab-right">
                    <div class="jn-brief-box">
                        <span class="jn-mono jn-xs jn-muted">DIRECT STUDIO DISPATCH</span>
                        <h3>Send a Project Brief</h3>
                        {% if config.plugins.form.enabled and page.header.form %}
                            {% include "forms/form.html.twig" %}
                        {% elseif contact_email %}
                            <p class="jn-muted jn-collab-copy">
                                Ready to collaborate? Send your project scope, references, and target timeline directly via email.
                            </p>
                            <a href="mailto:{{ contact_email|e('url') }}?subject={{ 'Project Brief'|url_encode }}" class="jn-btn jn-btn-crimson jn-btn-full">
                                Send a Project Brief &rarr;
                            </a>
                        {% else %}
                            <p class="jn-muted">
                                Enable the Grav <code>Form</code> plugin or set a contact email in theme settings to activate project inquiries.
                            </p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
